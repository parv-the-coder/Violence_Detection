# Copy to .env and fill in real values. .env is gitignored -- never commit it.
#
# Gmail account used to send alerts and reports. For Gmail you must use an
# App Password (Google Account -> Security -> App passwords), not your
# normal account password.
SURVEILLANCE_EMAIL_SENDER=
SURVEILLANCE_EMAIL_PASSWORD=

# Default recipient for alerts and summary reports. The dashboard can
# override this at runtime without touching this file.
SURVEILLANCE_EMAIL_RECIPIENT=

# SMTP transport. Defaults suit Gmail; change for another provider.
SURVEILLANCE_SMTP_HOST=smtp.gmail.com
SURVEILLANCE_SMTP_PORT=587

# Optional: path to the trained temporal classifier checkpoint.
# Defaults to model/best_model.pt inside the project.
# SURVEILLANCE_MODEL_PATH=/absolute/path/to/best_model.pt
